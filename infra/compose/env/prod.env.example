# Prod environment. Copy to prod.env (gitignored), fill in, then encrypt for the repo:
#   sops --encrypt infra/compose/env/prod.env > infra/compose/env/prod.enc.env
# On the host, decrypt back to prod.env before `docker compose up` (docs/runbook/hosting.md).
# From Phase 3: no prod deploys 07:00–15:00 Asia/Riyadh (ADR-008).

# Secrets (use different values from staging)
POSTGRES_PASSWORD=change-me
CLOUDFLARE_TUNNEL_TOKEN=

# Images
REGISTRY=platform
TAG=local

# Host ports (bound to BIND_ADDRESS only)
BIND_ADDRESS=127.0.0.1
API_PORT=3001
STAFF_PORT=3000
STUDENT_PORT=8080

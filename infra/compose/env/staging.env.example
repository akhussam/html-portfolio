# Staging environment. Copy to staging.env (gitignored), fill in, then encrypt for the repo:
#   sops --encrypt infra/compose/env/staging.env > infra/compose/env/staging.enc.env
# On the host, decrypt back to staging.env before `docker compose up` (docs/runbook/hosting.md).

# Secrets
POSTGRES_PASSWORD=change-me
CLOUDFLARE_TUNNEL_TOKEN=

# Images: "platform" + TAG=local builds on this host; step 0.7 switches to ghcr.io/akhussam/... images.
REGISTRY=platform
TAG=local

# Host ports (bound to BIND_ADDRESS only). Staging and prod use different ports on one host.
BIND_ADDRESS=127.0.0.1
API_PORT=3101
STAFF_PORT=3100
STUDENT_PORT=8180

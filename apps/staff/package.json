{
  "name": "@platform/staff",
  "version": "0.0.0",
  "private": true,
  "description": "Staff web app (Next.js): mounts the guide, admin, author and ops panels plus the parent page",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",

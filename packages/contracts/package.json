{
  "name": "@platform/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Contracts: engine.proto, lesson-player OpenAPI, panels GraphQL, item and event JSON Schemas, with generated TypeScript",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./graphql/schema.graphql": "./graphql/schema.graphql"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . && buf lint",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@bufbuild/buf": "1.73.0",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "graphql": "16.14.2",
    "json-schema-to-typescript": "16.0.0",
    "openapi-typescript": "7.13.0",
    "yaml": "2.9.1"
  },
  "files": [
    "dist",
    "graphql"
  ]
}

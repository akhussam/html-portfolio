{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "globalPassThroughEnv": [
    "UV_*"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "test": {
      "outputs": [
        "coverage/**"
      ]
    }
  }
}
